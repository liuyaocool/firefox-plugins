{
    "manifest_version": 3,
    "name": "Tab Switcher +",
    "version": "2.0",
    "description": "Tab switcher +",
    "icons": {
        "32": "img/32.png",
        "64": "img/64.png",
        "128": "img/128.png"
    },
    "action": {
        "default_icon": {
            "64": "img/64.png",
            "32": "img/32.png",
            "128": "img/128.png"
        },
        "default_popup": "popup.html"
    },
    "commands": {
        "prev_tab_last": {
            "suggested_key": { "default": "Alt+Q" },
            "description": "Prev tab. (last active order)"
        },
        "next_tab_last": {
            "suggested_key": { "default": "Alt+W" },
            "description": "Next tab. (last active order)"
        },
        "prev_tab_site": {
            "suggested_key": { "default": "Alt+E" },
            "description": "Prev tab. (same-domain by window order)"
        },
        "next_tab_site": {
            "suggested_key": { "default": "Alt+R" },
            "description": "Next tab. (same-domain by window order)"
        },
        "prev_tab": {
            "suggested_key": { "default": "Alt+S" },
            "description": "Prev tab. (window order)"
        },
        "next_tab": {
            "suggested_key": { "default": "Alt+F" },
            "description": "Next tab. (window order)"
        },
        "search_tab": {
            "suggested_key": { "default": "Alt+P" },
            "description": "Search tab"
        },
        "duplicate_tab": {
            "suggested_key": { "default": "Alt+C" },
            "description": "Duplicate tab"
        }
    },
    "background": {
        "scripts": [
            "constant.js",
            "bg.js"
        ]
    },
    "permissions": [
        "tabs",
        "menus",
        "storage"
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "v3_hotkey.ffp@61linux.com",
            "strict_min_version": "142.0",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    }
}